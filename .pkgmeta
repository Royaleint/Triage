package-as: Triage

enable-nolib-creation: no
enable-toc-creation: yes

manual-changelog:
  filename: RELEASE_NOTES.html
  markup-type: html

# BigWigsMods/packager does not support "!" negation in this list (confirmed
# by reading release.sh's yaml_listitem()/parse_ignore(): a leading "!" is
# never stripped or interpreted, so "!README.md" only matches a file
# literally named that). Do not reach for a "*.md" + "!exceptions" idiom here
# — it silently strips every .md file, README and CHANGELOG included, with
# no CI signal (STU-134 finding; every release zip has shipped without them).
# This list is deny-by-default for everything else, but for markdown
# specifically it is effectively allow-by-default: only the files below are
# named, so a new root .md file (a CONTRIBUTING.md, a NOTES.md) ships to
# players unless it is added here explicitly. The same applies to markdown
# inside `externals:` checkouts: the packager filters fetched libraries with
# this same list, so a README or CHANGELOG an upstream library adds ships
# until it is named here (the Libs/ entries below).
ignore:
  - .git
  - .gitignore
  - .pkgmeta
  - .claude
  - .codex
  - .mcp.json
  - .luacheckrc
  - .env
  - SHELVED.md
  - Libs/LibClassicDurations/CHANGELOG.md
  - Libs/LibDeflate/README.md
  - Libs/LibDeflate/changelog.md
  - Libs/LibDeflate/docs/README.md
  - Libs/LibDeflate/docs/benchmark.md
  - Libs/LibDeflate/CONTRIBUTING.md
  - Libs/LibRangeCheck-3.0/README.md
  - Libs/LibCustomGlow/README.md
  - RELEASE_NOTES.html
  - tests
  - Triage_Dev
  # TRI-050 build-matrix dev-build files (generated by Triage_Dev/scripts/
  # generate-devbuild-toc.mjs, gitignored). These two names are the entire
  # defense against shipping a second TOC (build-matrix.md § Generated files —
  # CI's TOC-vs-zip check does not count TOCs, so a leak here passes silently).
  - Triage_DevBuild.toc
  - DevBuildGuard.lua

# Externals migration (v1.0.0): switched from `embedded-libraries` to `externals`
# because the packager auto-derives CurseForge slugs from `embedded-libraries`
# entry names keeping dots (e.g. `libdualspec-1.0`), while CurseForge stores
# slugs with hyphens (e.g. `libdualspec-1-0`). External URLs let us name the
# slug correctly via the URL path. Matches Homestead's pattern.
#
# AceTab-3.0 was vendored from ERF but unused — removed entirely. Re-add via
# externals + curse-slug override if TRI-014 (autocomplete) uses the Tab-key
# pattern.

externals:
  # Core Ace3
  Libs/LibStub: https://repos.wowace.com/wow/libstub/trunk
  Libs/CallbackHandler-1.0: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  Libs/AceAddon-3.0: https://repos.wowace.com/wow/ace3/trunk/AceAddon-3.0
  Libs/AceBucket-3.0: https://repos.wowace.com/wow/ace3/trunk/AceBucket-3.0
  Libs/AceComm-3.0: https://repos.wowace.com/wow/ace3/trunk/AceComm-3.0
  Libs/AceConfig-3.0: https://repos.wowace.com/wow/ace3/trunk/AceConfig-3.0
  Libs/AceConsole-3.0: https://repos.wowace.com/wow/ace3/trunk/AceConsole-3.0
  Libs/AceDB-3.0: https://repos.wowace.com/wow/ace3/trunk/AceDB-3.0
  Libs/AceDBOptions-3.0: https://repos.wowace.com/wow/ace3/trunk/AceDBOptions-3.0
  Libs/AceEvent-3.0: https://repos.wowace.com/wow/ace3/trunk/AceEvent-3.0
  Libs/AceGUI-3.0: https://repos.wowace.com/wow/ace3/trunk/AceGUI-3.0
  Libs/AceHook-3.0: https://repos.wowace.com/wow/ace3/trunk/AceHook-3.0
  Libs/AceLocale-3.0: https://repos.wowace.com/wow/ace3/trunk/AceLocale-3.0
  Libs/AceSerializer-3.0: https://repos.wowace.com/wow/ace3/trunk/AceSerializer-3.0
  Libs/AceTimer-3.0: https://repos.wowace.com/wow/ace3/trunk/AceTimer-3.0

  # WowAce-hosted libs (URLs verified to return SVN-valid 301; slug matches CF)
  Libs/AceGUI-3.0-SharedMediaWidgets: https://repos.wowace.com/wow/ace-gui-3-0-shared-media-widgets/trunk
  Libs/LibSharedMedia-3.0: https://repos.wowace.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0
  Libs/LibDataBroker-1.1: https://repos.wowace.com/wow/libdatabroker-1-1
  Libs/LibDBIcon-1.0: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0

  # GitHub-hosted libs (not on WowAce SVN; CF presence verified — use curse-slug
  # to declare the CurseForge project relation explicitly)
  Libs/LibDualSpec-1.0:
    url: https://github.com/Adirelle/LibDualSpec-1.0.git
    branch: master
    curse-slug: libdualspec-1-0
  Libs/LibRangeCheck-3.0:
    url: https://github.com/mitchnull/LibRangeCheck-3.0.git
    branch: main
    curse-slug: librangecheck-3-0
  Libs/LibDeflate:
    url: https://github.com/SafeteeWoW/LibDeflate.git
    branch: main
    curse-slug: libdeflate
  Libs/LibClassicDurations:
    url: https://github.com/rgd87/LibClassicDurations.git
    branch: master
    curse-slug: libclassicdurations

  # GitHub-hosted libs without verified CurseForge presence — no curse-slug,
  # packager will skip the CF relation declaration (libs still get packaged)
  Libs/LibDispel:
    url: https://github.com/tukui-org/LibDispel.git
    branch: main
  Libs/LibCustomGlow:
    url: https://github.com/Stanzilla/LibCustomGlow.git
    branch: master
